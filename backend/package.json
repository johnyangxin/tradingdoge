{
  "name": "tradingdoge-backend",
  "version": "1.0.0",
  "description": "TradingDoge stock display backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.workers.json",
    "build:local": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "fetch": "tsx scripts/fetch-data.ts",
    "fetch:local": "tsx scripts/fetch-data-local.ts",
    "deploy": "wrangler deploy",
    "dev:workers": "wrangler dev"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "@libsql/client": "^0.17.3",
    "axios": "^1.15.2",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.19",
    "@types/node-cron": "^3.0.11",
    "@types/sql.js": "^1.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}
